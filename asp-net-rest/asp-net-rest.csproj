<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>AspNetRest</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- Warnungen als Fehler halten die Schulungslösung sauber. -->
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

    <ItemGroup>
        <!-- FluentValidation: die "fluent" Validierungs-DSL. -->
        <PackageReference Include="FluentValidation" Version="12.1.1"/>
        <!-- Registriert alle Validatoren automatisch in der MEDI-Container-Registrierung. -->
        <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1"/>
        <!-- Erzeugt das OpenAPI-Dokument unter /openapi/v1.json. -->
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11"/>
    </ItemGroup>

</Project>
